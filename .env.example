# Optional. Copy to .env to override the Windows system proxy.
MYDESK_PROXY_URL=auto
# HTTP proxy: MYDESK_PROXY_URL=http://127.0.0.1:7890
# SOCKS5 proxy: MYDESK_PROXY_URL=socks5h://127.0.0.1:21001
# MYDESK_USE_SYSTEM_PROXY=0
# 第 1 层（按进程名识别本机代理 + 常见代理端口）的开关。0 = 跳过这一层。
# MYDESK_PROXY_DISCOVERY=0
# 第 2 层（全端口兜底扫描）的开关。0 = 跳过这一层；前两层全灭时它才会启动。
# MYDESK_PROXY_WIDE_SCAN=0
PORT=4173

# Optional AI text translation. Public Bitget data needs no account key.
# MYDESK_AI_BASE_URL=https://api.deepseek.com/v1
# MYDESK_AI_MODEL=deepseek-chat
# MYDESK_AI_KEY=
